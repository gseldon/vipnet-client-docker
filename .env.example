KEYFILE_PASS=""
# Команда проверки; пусто = отключено. Примеры: curl -fsS -o /dev/null http://intranet.example.local | ping -c 4 intranet.example.local
HEALTHCHECK_CMD="curl -fsS -m 10 -o /dev/null http://intranet.example.local"
DNS_SERVER="77.88.8.8"
DEBUG_LEVEL="1"
# Нужен только при сборке (docker-compose.build.yml)
INSTALL_DEB_PACKAGE="vipnetclient_gost_ru_amd64_4.12.0-8655.deb"
